      "item": [
        {
          "id": "94713059-bc6a-4460-9310-4c3a8e5b594d",
          "name": "Get Statements",
          "request": {
            "name": "Get Statements",
            "description": {
              "content": "The statements service is used to get the list of statement related information. <br>By default, all the latest statements of active and to be closed accounts are retrieved for the user. <br>Certain sites do not have both a statement date and a due date. When a fromDate is passed as an input, all the statements that have the due date on or after the passed date are retrieved. <br>For sites that do not have the due date, statements that have the statement date on or after the passed date are retrieved. <br>The default value of \"isLatest\" is true. To retrieve historical statements isLatest needs to be set to false.<br>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "statements"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "accountId",
                  "value": "<string>",
                  "description": "accountId"
                },
                {
                  "disabled": false,
                  "key": "container",
                  "value": "<string>",
                  "description": "creditCard/loan/insurance"
                },
                {
                  "disabled": false,
                  "key": "fromDate",
                  "value": "<string>",
                  "description": "from date for statement retrieval (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "isLatest",
                  "value": "<string>",
                  "description": "isLatest (true/false)"
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "ACTIVE,TO_BE_CLOSED,CLOSED"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json;charset=UTF-8"
              }
            ],
            "method": "GET",
            "auth": null
          },
